{
  "uid": "java-overview",
  "title": "Java Application Overview",
  "tags": ["java", "micrometer"],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "15s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1, "title": "Application scrape status (1 = UP)", "type": "stat",
      "description": "Prometheus can scrape the application when up = 1. This differs from /actuator/health.",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "up{job=\"devops-learning\"}", "instant": true}],
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}
    },
    {
      "id": 2, "title": "JVM memory used by pool", "type": "timeseries",
      "gridPos": {"x": 6, "y": 0, "w": 18, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "jvm_memory_used_bytes{job=\"devops-learning\"}", "legendFormat": "{{area}} / {{id}}"}],
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}, "overrides": []}
    },
    {
      "id": 3, "title": "CPU usage", "type": "timeseries",
      "description": "Process and system CPU reported by the JVM. System scope depends on JVM/container support; these are not container CPU quota percentages.",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "process_cpu_usage{job=\"devops-learning\"}", "legendFormat": "Java process"},
        {"refId": "B", "expr": "system_cpu_usage{job=\"devops-learning\"}", "legendFormat": "System (JVM reported)"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}
    },
    {
      "id": 4, "title": "HTTP requests per second", "type": "timeseries",
      "description": "Generate /hello and /greet requests first. rate needs at least two scrapes. Management endpoint traffic is excluded.",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (uri, method, status) (rate(http_server_requests_seconds_count{job=\"devops-learning\",uri!~\"/actuator.*\"}[$__rate_interval]))", "legendFormat": "{{method}} {{uri}} {{status}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []}
    },
    {
      "id": 5, "title": "HTTP average response time", "type": "timeseries",
      "description": "Total duration per second divided by request count per second. No requests means no average; gaps are expected.",
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (uri) (rate(http_server_requests_seconds_sum{job=\"devops-learning\",uri!~\"/actuator.*\"}[$__rate_interval])) / sum by (uri) (rate(http_server_requests_seconds_count{job=\"devops-learning\",uri!~\"/actuator.*\"}[$__rate_interval]))", "legendFormat": "{{uri}}"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}
    },
    {
      "id": 6, "title": "HTTP 4xx / 5xx requests per second", "type": "timeseries",
      "description": "A series appears only after the application has returned that status at least once.",
      "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"devops-learning\",uri!~\"/actuator.*\",status=~\"4..|5..\"}[$__rate_interval]))", "legendFormat": "HTTP {{status}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []}
    }
  ]
}
